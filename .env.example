# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional explicit origin for email confirmation links; must be in Supabase redirect allowlist.
# Vercel defaults to its deployment URL; local defaults to http://127.0.0.1:3000.
NEXT_PUBLIC_APP_URL=
# Server-side integrations; leave blank until these are configured.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
